{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "runs": [
    {
      "results": [],
      "tool": {
        "driver": {
          "informationUri": "https://github.com/MysterionRise/forgetest",
          "name": "forgetest",
          "rules": [
            {
              "id": "compilation-failure",
              "name": "Compilation Failure",
              "shortDescription": {
                "text": "The generated code failed to compile"
              }
            },
            {
              "id": "test-failure",
              "name": "Test Failure",
              "shortDescription": {
                "text": "One or more tests failed"
              }
            },
            {
              "id": "clippy-warning",
              "name": "Clippy Warning",
              "shortDescription": {
                "text": "Clippy reported a warning"
              }
            }
          ],
          "version": "0.1.0"
        }
      }
    }
  ],
  "version": "2.1.0"
}